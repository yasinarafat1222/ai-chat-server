{
  "name": "jazari-bridge-ui",
  "productName": "JAZARI Bridge UI",
  "version": "0.14.178",
  "description": "JAZARI 0.14.178 Bridge UI - Windows desktop app",
  "author": "Yasin Arafat",
  "license": "ISC",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.jazari.bridgeui",
    "productName": "JAZARI Bridge UI",
    "copyright": "Copyright © 2026 Yasin Arafat",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "ui/**/*"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "JAZARI Bridge UI",
      "artifactName": "JAZARI-Bridge-UI-Setup-${version}.${ext}"
    }
  }
}
